# =============================================================================
# Локально: скопируйте в .env.local (файл в .gitignore, не коммитить).
# Cloudflare Pages: https://dash.cloudflare.com → ваш проект Pages →
#   Settings → Environment variables → Production / Preview
# =============================================================================
#
# VITE_SUPABASE_URL — Supabase Dashboard → Project Settings → API → Project URL
#   Пример формата: https://abcdefghijklmnop.supabase.co
#
# VITE_SUPABASE_ANON_KEY — тот же раздел API: anon (JWT eyJ...) или Publishable (sb_publishable_...)
#   НЕ используйте service_role и НЕ кладите sb_secret_* в VITE_*.

VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_OR_ANON_PUBLIC_KEY
