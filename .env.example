# Локально: скопируйте в .env.local (не коммитить).
# Cloudflare Pages: Settings → Environment variables → задать для Production (и Preview при необходимости).
#
# VITE_SUPABASE_URL — Project URL (https://xxxx.supabase.co), см. Supabase Dashboard → Settings → API.
# VITE_SUPABASE_ANON_KEY — публичный ключ для клиента: legacy «anon» JWT (eyJ...) ИЛИ Publishable (sb_publishable_...).
# НИКОГДА не кладите в VITE_* секретные ключи (sb_secret_..., service_role).

VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_OR_ANON_PUBLIC_KEY
